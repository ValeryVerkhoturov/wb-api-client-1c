// Добавить товары в черновик
//
// Метод [доступен](https://dev.wildberries.ru/openapi/api-information#tag/authorization/Pravila-ispolzovaniya-tokenov-dostupa-k-API) по
// **Персональному** токену,
// **Сервисному** токену
//
// Метод добавляет товары в черновик поставки.
//
// Метод работает по принципу атомарности:
// - если все баркоды прошли валидацию успешно, то все товары добавятся в черновик. В ответе вернётся `{\"results\":[]}`
// - если хотя бы один баркод не прошел валидацию, ни один товар в черновик не добавится. В ответе вернётся список невалидных баркодов
//
// [Лимит запросов](https://dev.wildberries.ru/openapi/api-information#tag/introduction/Limity-zaprosov) на один аккаунт продавца:
// | Период | Лимит | Интервал | Всплеск |
// | --- | --- | --- | --- |
// | 1 мин | 30 запросов | 2 сек | 10 запросов |
//
// Параметры:
//   draftId - Строка - ID черновика
//   Тело - OrdersFbwModelsDraftAdditemsRequest
//
// Возвращаемое значение:
//   ОтветAPI
//
Функция PostV1DraftsDraftIdItems(Знач draftId, Знач Тело) Экспорт

	ПараметрыЗапроса = Новый Соответствие;
	Заголовки = Новый Соответствие;
	Возврат Транспорт.ВыполнитьЗапрос(
		"POST",
		СтрШаблон("/api/supplies/v1/drafts/%1/items", Транспорт.ЭкранироватьСегмент(draftId)),
		ПараметрыЗапроса,
		Заголовки,
		Тело,
		"https://supplies-api.wildberries.ru");

КонецФункции

// Список поставок
//
// Метод возвращает список поставок, по умолчанию — последние 1000 поставок.
//
// [Лимит запросов](https://dev.wildberries.ru/openapi/api-information#tag/introduction/Limity-zaprosov) на один аккаунт продавца:
// | Тип | Период | Лимит | Интервал | Всплеск |
// | --- | --- | --- | --- | --- |
// | Персональный | 1 мин | 30 запросов | 2 сек | 10 запросов |
// | Сервисный | 1 мин | 30 запросов | 2 сек | 10 запросов |
// | Базовый с секретом | 1 мин | 30 запросов | 2 сек | 10 запросов |
// | Базовый | 1 ч | 2 запроса | 30 мин | 1 запрос |
//
// Параметры:
//   Тело - OrdersFbwModelsSuppliesFiltersRequest
//   ДопПараметры - Структура, Соответствие - необязательные параметры:
//    * limit - Число - Количество записей в ответе
//    * offset - Число - После какого элемента выдавать данные
//
// Возвращаемое значение:
//   ОтветAPI
//
Функция PostV1Supplies(Знач Тело, Знач ДопПараметры = Неопределено) Экспорт

	ПараметрыЗапроса = Новый Соответствие;
	Заголовки = Новый Соответствие;

	ИменаЗаголовков = Новый Массив;
	Транспорт.РазложитьПараметры(ДопПараметры, ИменаЗаголовков, ПараметрыЗапроса, Заголовки);
	Возврат Транспорт.ВыполнитьЗапрос(
		"POST",
		"/api/v1/supplies",
		ПараметрыЗапроса,
		Заголовки,
		Тело,
		"https://supplies-api.wildberries.ru");

КонецФункции

