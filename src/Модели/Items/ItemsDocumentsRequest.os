#Использовать jason

// ItemsDocumentsRequest
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// type - Число - Тип документа. Типы документов, которые вы можете добавить для товара, указаны в [характеристиках предмета](./item-management#tag/categoriesSubcategoriesAndChar…
&Сериализуемое("type")
&Тип("Число")
Перем type Экспорт;

// number - Строка - Номер документа
&Сериализуемое("number")
&Тип("Строка")
Перем number Экспорт;

// productNumber - Строка - Дополнительный номер документа
&Сериализуемое("productNumber")
&Тип("Строка")
Перем productNumber Экспорт;

// tradeName - Строка - Торговое наименование
&Сериализуемое("tradeName")
&Тип("Строка")
Перем tradeName Экспорт;

// applicant - Строка - Представитель изготовителя медицинского изделия
&Сериализуемое("applicant")
&Тип("Строка")
Перем applicant Экспорт;

// startDate - Строка - Дата и время начала срока действия документа
&Сериализуемое("startDate")
&Тип("Строка")
Перем startDate Экспорт;

// endDate - Строка - Дата и время окончания срока действия документа
&Сериализуемое("endDate")
&Тип("Строка")
Перем endDate Экспорт;

// isEndless - Булево - Бессрочный ли документ: - `true` — да, документ бессрочный - `false` — нет, у документа есть срок действия
&Сериализуемое("isEndless")
&Тип("Булево")
Перем isEndless Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

