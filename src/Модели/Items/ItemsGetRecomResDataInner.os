#Использовать jason

// ItemsGetRecomResDataInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// imtId - Число - ID для [объединённых](https://dev.wildberries.ru/knowledge-base/articles/019d49a4-1320-71bb-9dac-8ba07e7177ce/rabota-s-tovarami#obuedinenie-i-razuedinenie-karto…
&Сериализуемое("imtId")
&Тип("Число")
Перем imtId Экспорт;

// vendorCode - Строка - Артикул продавца
&Сериализуемое("vendorCode")
&Тип("Строка")
Перем vendorCode Экспорт;

// brandName - Строка - Бренд
&Сериализуемое("brandName")
&Тип("Строка")
Перем brandName Экспорт;

// updatedAt - Дата - Дата и время последнего обновления рекомендаций
&Сериализуемое("updatedAt")
&Тип("Дата")
Перем updatedAt Экспорт;

// picsCount - Число - Количество изображений в карточке товара
&Сериализуемое("picsCount")
&Тип("Число")
Перем picsCount Экспорт;

// title - Строка - Название товара
&Сериализуемое("title")
&Тип("Строка")
Перем title Экспорт;

// subjectName - Строка - Предмет
&Сериализуемое("subjectName")
&Тип("Строка")
Перем subjectName Экспорт;

// pic - Строка - URL основного изображения в карточке товара
&Сериализуемое("pic")
&Тип("Строка")
Перем pic Экспорт;

// recomCount - Число - Количество рекомендуемых товаров
&Сериализуемое("recomCount")
&Тип("Число")
Перем recomCount Экспорт;

// recomPics - Массив - Список URL основных изображений рекомендуемых товаров
&Сериализуемое("recomPics")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем recomPics Экспорт;

// recomNms - Массив - Список `nmId` рекомендуемых товаров
&Сериализуемое("recomNms")
&Тип("Массив")
&ДляКаждого
&Тип("Число")
Перем recomNms Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

