#Использовать jason

// ItemsSellerTaskMetadata
//
// Данные ответа
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// uploadID - Число - ID загрузки
&Сериализуемое("uploadID")
&Тип("Число")
Перем uploadID Экспорт;

// status - Число - Статус загрузки: * `3` — обработана, в товарах нет ошибок, цены и скидки обновились * `4` — отменена * `5` — обработана, но в товарах есть ошибки. Для товаров б…
&Сериализуемое("status")
&Тип("Число")
Перем status Экспорт;

// uploadDate - Строка - Дата и время, когда загрузка создана
&Сериализуемое("uploadDate")
&Тип("Строка")
Перем uploadDate Экспорт;

// activationDate - Строка - Дата и время, когда загрузка отправляется в обработку
&Сериализуемое("activationDate")
&Тип("Строка")
Перем activationDate Экспорт;

// overAllGoodsNumber - Число - Всего товаров
&Сериализуемое("overAllGoodsNumber")
&Тип("Число")
Перем overAllGoodsNumber Экспорт;

// successGoodsNumber - Число - Товаров без ошибок
&Сериализуемое("successGoodsNumber")
&Тип("Число")
Перем successGoodsNumber Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

