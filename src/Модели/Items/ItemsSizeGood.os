#Использовать jason

// ItemsSizeGood
//
// Информация о размере
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// nmID - Число - Артикул WB
&Сериализуемое("nmID")
&Тип("Число")
Перем nmID Экспорт;

// sizeID - Число - ID размера. Можно получить с помощью метода [Получение списка товаров по артикулам](./item-management#tag/pricesAndDiscounts/operation/getV2ListGoodsFilter), по…
&Сериализуемое("sizeID")
&Тип("Число")
Перем sizeID Экспорт;

// vendorCode - Строка - Артикул продавца
&Сериализуемое("vendorCode")
&Тип("Строка")
Перем vendorCode Экспорт;

// price - Число - Цена
&Сериализуемое("price")
&Тип("Число")
Перем price Экспорт;

// currencyIsoCode4217 - Строка - Валюта, по стандарту ISO 4217
&Сериализуемое("currencyIsoCode4217")
&Тип("Строка")
Перем currencyIsoCode4217 Экспорт;

// discountedPrice - Число - Цена со скидкой
&Сериализуемое("discountedPrice")
&Тип("Число")
Перем discountedPrice Экспорт;

// clubDiscountedPrice - Число - Цена со скидкой, включая скидку WB Клуба
&Сериализуемое("clubDiscountedPrice")
&Тип("Число")
Перем clubDiscountedPrice Экспорт;

// discount - Число - Скидка, %
&Сериализуемое("discount")
&Тип("Число")
Перем discount Экспорт;

// clubDiscount - Число - Скидка WB Клуба, %
&Сериализуемое("clubDiscount")
&Тип("Число")
Перем clubDiscount Экспорт;

// techSizeName - Строка - Размер товара
&Сериализуемое("techSizeName")
&Тип("Строка")
Перем techSizeName Экспорт;

// editableSizePrice - Булево - Можно ли устанавливать цены отдельно для разных размеров (зависит от категории товара): - `true` — можно - `false` — нельзя
&Сериализуемое("editableSizePrice")
&Тип("Булево")
Перем editableSizePrice Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

