#Использовать jason

// ItemsWarehouse
//
// Данные о складе продавца
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// name - Строка - Название склада продавца
&Сериализуемое("name")
&Тип("Строка")
Перем name Экспорт;

// officeId - Число - ID склада WB
&Сериализуемое("officeId")
&Тип("Число")
Перем officeId Экспорт;

// id - Число - ID склада продавца
&Сериализуемое("id")
&Тип("Число")
Перем id Экспорт;

// cargoType - Число - Тип товара: - `1` — малогабаритный товар (МГТ) - `2` — сверхгабаритный товар (СГТ) - `3` — крупногабаритный товар (КГТ+)
&Сериализуемое("cargoType")
&Тип("Число")
Перем cargoType Экспорт;

// deliveryType - Число - Тип доставки, который принимает склад: - `1` — доставка на склад WB (FBS) - `2` — доставка силами продавца (DBS) - `3` — Деливери WB (DBW) - `5` — самовывоз (C&…
&Сериализуемое("deliveryType")
&Тип("Число")
Перем deliveryType Экспорт;

// isDeleting - Булево - Склад удаляется: - `false` — нет - `true` — да После удаления склад пропадёт из списка
&Сериализуемое("isDeleting")
&Тип("Булево")
Перем isDeleting Экспорт;

// isProcessing - Булево - Данные склада обновляются: - `false` — нет - `true` — да, обновление и удаление остатков недоступно Обновление данных может занимать несколько минут
&Сериализуемое("isProcessing")
&Тип("Булево")
Перем isProcessing Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

