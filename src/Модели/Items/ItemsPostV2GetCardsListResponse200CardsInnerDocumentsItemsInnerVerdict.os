#Использовать jason

// ItemsPostV2GetCardsListResponse200CardsInnerDocumentsItemsInnerVerdict
//
// Результат проверки документа. Возвращается, когда проверка документа завершена
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// verified - Булево - - `true` — документ проверен - `false` — документ не проверен
&Сериализуемое("verified")
&Тип("Булево")
Перем verified Экспорт;

// status - Число - Результат проверки документа: - `1` — проверка пройдена - `2` — проверка не пройдена
&Сериализуемое("status")
&Тип("Число")
Перем status Экспорт;

// reason - Строка - Ошибка при проверке, возвращается для `status: 2`. Возможные значения: - `document\\_missing` — Документ не загружен - `document\\_not\\_found` — Документ не на…
&Сериализуемое("reason")
&Тип("Строка")
Перем reason Экспорт;

// additionalData - Соответствие - Дополнительная информация
&Сериализуемое("additionalData")
&Тип("Соответствие")
Перем additionalData Экспорт;

// createdAt - Строка - Дата проверки документа
&Сериализуемое("createdAt")
&Тип("Строка")
Перем createdAt Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

