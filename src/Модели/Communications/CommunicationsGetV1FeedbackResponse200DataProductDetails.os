#Использовать jason

// CommunicationsGetV1FeedbackResponse200DataProductDetails
//
// Item information
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// imtId - Число - ID для [объединённых](https://dev.wildberries.ru/knowledge-base/articles/019d49a4-1320-71bb-9dac-8ba07e7177ce/rabota-s-tovarami#obuedinenie-i-razuedinenie-karto…
&Сериализуемое("imtId")
&Тип("Число")
Перем imtId Экспорт;

// productName - Строка - Название товара
&Сериализуемое("productName")
&Тип("Строка")
Перем productName Экспорт;

// supplierArticle - Строка - Артикул продавца
&Сериализуемое("supplierArticle")
&Тип("Строка")
Перем supplierArticle Экспорт;

// supplierName - Строка - Имя продавца
&Сериализуемое("supplierName")
&Тип("Строка")
Перем supplierName Экспорт;

// brandName - Строка - Бренд товара
&Сериализуемое("brandName")
&Тип("Строка")
Перем brandName Экспорт;

// size - Строка - Размер товара (`techSize` в КТ)
&Сериализуемое("size")
&Тип("Строка")
Перем size Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

