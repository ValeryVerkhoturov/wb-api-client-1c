#Использовать jason

// CommunicationsEvent
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// chatID - Строка - ID чата
&Сериализуемое("chatID")
&Тип("Строка")
Перем chatID Экспорт;

// eventID - Строка - ID события
&Сериализуемое("eventID")
&Тип("Строка")
Перем eventID Экспорт;

// eventType - CommunicationsEventType
&Сериализуемое("eventType")
&Тип("CommunicationsEventType")
Перем eventType Экспорт;

// isNewChat - Булево - Признак нового чата: - `false` — чат не новый - `true` — чат новый
&Сериализуемое("isNewChat")
&Тип("Булево")
Перем isNewChat Экспорт;

// message - CommunicationsEventMessage
&Сериализуемое("message")
&Тип("CommunicationsEventMessage")
Перем message Экспорт;

// source - Строка - Источник отправки сообщения: - `seller-portal` — портал продавцов - `seller-public-api` — API Чата с покупателями - `rusite` — портал покупателей - `global` — п…
&Сериализуемое("source")
&Тип("Строка")
Перем source Экспорт;

// addTimestamp - Число - Время появления события на сервере. Формат Unix timestamp
&Сериализуемое("addTimestamp")
&Тип("Число")
Перем addTimestamp Экспорт;

// addTime - Строка - Время появления события на сервере в UTC
&Сериализуемое("addTime")
&Тип("Строка")
Перем addTime Экспорт;

// replySign - Строка - Подпись чата. Доступна только при `\"isNewChat\": true`. Требуется при [отправке сообщения](./customer-communication#tag/buyersChat/operation/postV1SellerMessag…
&Сериализуемое("replySign")
&Тип("Строка")
Перем replySign Экспорт;

// sender - CommunicationsSender
&Сериализуемое("sender")
&Тип("CommunicationsSender")
Перем sender Экспорт;

// clientName - Строка - Имя покупателя
&Сериализуемое("clientName")
&Тип("Строка")
Перем clientName Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

