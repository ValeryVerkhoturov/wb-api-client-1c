#Использовать jason

// ReportsGoodsReturn200ResponseReportInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// sku - Строка - Баркод
&Сериализуемое("sku")
&Тип("Строка")
Перем sku Экспорт;

// brand - Строка - Бренд
&Сериализуемое("brand")
&Тип("Строка")
Перем brand Экспорт;

// completedDt - Строка - Дата и время выдачи возврата продавцу
&Сериализуемое("completedDt")
&Тип("Строка")
Перем completedDt Экспорт;

// dstOfficeAddress - Строка - Адрес ПВЗ для выдачи возврата продавцу
&Сериализуемое("dstOfficeAddress")
&Тип("Строка")
Перем dstOfficeAddress Экспорт;

// kiz - Строка - Код маркировки [Честного знака](https://честныйзнак.рф/)
&Сериализуемое("kiz")
&Тип("Строка")
Перем kiz Экспорт;

// dstOfficeId - Число - ID ПВЗ для выдачи возврата продавцу
&Сериализуемое("dstOfficeId")
&Тип("Число")
Перем dstOfficeId Экспорт;

// expiredDt - Строка - Дата и время истечения срока хранения возврата
&Сериализуемое("expiredDt")
&Тип("Строка")
Перем expiredDt Экспорт;

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// orderDt - Дата - Дата заказа на возврат
&Сериализуемое("orderDt")
&Тип("Дата")
Перем orderDt Экспорт;

// orderId - Число - ID сборочного задания
&Сериализуемое("orderId")
&Тип("Число")
Перем orderId Экспорт;

// readyToReturnDt - Строка - Дата и время готовности возврата к выдаче
&Сериализуемое("readyToReturnDt")
&Тип("Строка")
Перем readyToReturnDt Экспорт;

// returnReason - Строка - Причина возврата. Поле возвращается только при `\"returnType\":\"Возврат неопознанного товара\"`
&Сериализуемое("returnReason")
&Тип("Строка")
Перем returnReason Экспорт;

// returnType - Строка - Тип возврата
&Сериализуемое("returnType")
&Тип("Строка")
Перем returnType Экспорт;

// shkId - Число - Штрихкод
&Сериализуемое("shkId")
&Тип("Число")
Перем shkId Экспорт;

// srid - Строка - ID заказа на возврат
&Сериализуемое("srid")
&Тип("Строка")
Перем srid Экспорт;

// returnStatus - Строка - Статус возврата
&Сериализуемое("returnStatus")
&Тип("Строка")
Перем returnStatus Экспорт;

// stickerId - Строка - Стикер заказа на возврат
&Сериализуемое("stickerId")
&Тип("Строка")
Перем stickerId Экспорт;

// subjectName - Строка - Предмет
&Сериализуемое("subjectName")
&Тип("Строка")
Перем subjectName Экспорт;

// techSize - Строка - Размер
&Сериализуемое("techSize")
&Тип("Строка")
Перем techSize Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

