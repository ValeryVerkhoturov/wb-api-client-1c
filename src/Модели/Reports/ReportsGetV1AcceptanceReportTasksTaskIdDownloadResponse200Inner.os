// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// count - Число - Количество товаров, шт.
&Сериализуемое("count")
&Тип("Число")
Перем count Экспорт;

// giCreateDate - Дата - Дата создания поставки
&Сериализуемое("giCreateDate")
&Тип("Дата")
Перем giCreateDate Экспорт;

// incomeId - Число - Номер поставки
&Сериализуемое("incomeId")
&Тип("Число")
Перем incomeId Экспорт;

// nmID - Число - Артикул WB
&Сериализуемое("nmID")
&Тип("Число")
Перем nmID Экспорт;

// shkCreateDate - Дата - Дата приёмки
&Сериализуемое("shkCreateDate")
&Тип("Дата")
Перем shkCreateDate Экспорт;

// subjectName - Строка - Предмет
&Сериализуемое("subjectName")
&Тип("Строка")
Перем subjectName Экспорт;

// total - Число - Суммарная стоимость приёмки, ₽ с копейками
&Сериализуемое("total")
&Тип("Число")
Перем total Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
