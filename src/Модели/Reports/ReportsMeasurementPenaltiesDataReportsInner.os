#Использовать jason

// ReportsMeasurementPenaltiesDataReportsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// subjectName - Строка - Предмет
&Сериализуемое("subjectName")
&Тип("Строка")
Перем subjectName Экспорт;

// dimId - Число - ID замера
&Сериализуемое("dimId")
&Тип("Число")
Перем dimId Экспорт;

// prcOver - Число - Разница в габаритах, %
&Сериализуемое("prcOver")
&Тип("Число")
Перем prcOver Экспорт;

// volume - Число - Объём, л (фактические габариты по замеру на складе)
&Сериализуемое("volume")
&Тип("Число")
Перем volume Экспорт;

// width - Число - Ширина, см (фактические габариты по замеру на складе)
&Сериализуемое("width")
&Тип("Число")
Перем width Экспорт;

// length - Число - Длина, см (фактические габариты по замеру на складе)
&Сериализуемое("length")
&Тип("Число")
Перем length Экспорт;

// height - Число - Высота, см (фактические габариты по замеру на складе)
&Сериализуемое("height")
&Тип("Число")
Перем height Экспорт;

// volumeSup - Число - Объём, л (габариты карточки товара)
&Сериализуемое("volumeSup")
&Тип("Число")
Перем volumeSup Экспорт;

// widthSup - Число - Ширина, см (габариты карточки товара)
&Сериализуемое("widthSup")
&Тип("Число")
Перем widthSup Экспорт;

// lengthSup - Число - Длина, см (габариты карточки товара)
&Сериализуемое("lengthSup")
&Тип("Число")
Перем lengthSup Экспорт;

// heightSup - Число - Высота, см (габариты карточки товара)
&Сериализуемое("heightSup")
&Тип("Число")
Перем heightSup Экспорт;

// photoUrls - Массив - Фото замеров
&Сериализуемое("photoUrls")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем photoUrls Экспорт;

// dtBonus - Дата - Дата штрафа
&Сериализуемое("dtBonus")
&Тип("Дата")
Перем dtBonus Экспорт;

// isValid - Булево - Статус обмера: - `false` — отменён - `true` — подтверждён
&Сериализуемое("isValid")
&Тип("Булево")
Перем isValid Экспорт;

// isValidDt - Дата - Дата и время подтверждения или отмены обмера
&Сериализуемое("isValidDt")
&Тип("Дата")
Перем isValidDt Экспорт;

// reversalAmount - Число - Сумма сторно
&Сериализуемое("reversalAmount")
&Тип("Число")
Перем reversalAmount Экспорт;

// penaltyAmount - Число - Сумма штрафа
&Сериализуемое("penaltyAmount")
&Тип("Число")
Перем penaltyAmount Экспорт;

// dateStart - Дата - Дата и время начала действия коэффициента
&Сериализуемое("dateStart")
&Тип("Дата")
Перем dateStart Экспорт;

// dateEnd - Дата - Дата и время окончания действия коэффициента
&Сериализуемое("dateEnd")
&Тип("Дата")
Перем dateEnd Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

