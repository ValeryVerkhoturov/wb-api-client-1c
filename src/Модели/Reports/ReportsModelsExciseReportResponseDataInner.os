#Использовать jason

// ReportsModelsExciseReportResponseDataInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// name - Строка - Страна покупателя
&Сериализуемое("name")
&Тип("Строка")
Перем name Экспорт;

// price - Число - Цена товара, с НДС
&Сериализуемое("price")
&Тип("Число")
Перем price Экспорт;

// currency_name_short - Строка - Валюта
&Сериализуемое("currency_name_short")
&Тип("Строка")
Перем currency_name_short Экспорт;

// excise_short - Строка - Код маркировки
&Сериализуемое("excise_short")
&Тип("Строка")
Перем excise_short Экспорт;

// barcode - Строка - Баркод
&Сериализуемое("barcode")
&Тип("Строка")
Перем barcode Экспорт;

// nm_id - Число - Артикул WB
&Сериализуемое("nm_id")
&Тип("Число")
Перем nm_id Экспорт;

// operation_type_id - Число - Тип операции, если есть: * `1` — вывод из оборота * `2` — возврат в оборот
&Сериализуемое("operation_type_id")
&Тип("Число")
Перем operation_type_id Экспорт;

// fiscal_doc_number - Число - Номер фискального документа (чека полного расчёта), если есть
&Сериализуемое("fiscal_doc_number")
&Тип("Число")
Перем fiscal_doc_number Экспорт;

// fiscal_dt - Строка - Дата фискализации (дата в чеке), если есть, `ГГГГ-ММ-ДД`
&Сериализуемое("fiscal_dt")
&Тип("Строка")
Перем fiscal_dt Экспорт;

// fiscal_drive_number - Строка - Номер фискального накопителя, если есть
&Сериализуемое("fiscal_drive_number")
&Тип("Строка")
Перем fiscal_drive_number Экспорт;

// rid - Число - `Rid`
&Сериализуемое("rid")
&Тип("Число")
Перем rid Экспорт;

// srid - Строка - `Srid`
&Сериализуемое("srid")
&Тип("Строка")
Перем srid Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

