#Использовать jason

// ReportsOrdersItem
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// date - Строка - Дата и время заказа. Это поле соответствует параметру `dateFrom` в запросе, если параметр `flag`=1. Если часовой пояс не указан, то берётся Московское время (UT…
&Сериализуемое("date")
&Тип("Строка")
Перем date Экспорт;

// lastChangeDate - Строка - Дата и время обновления информации в сервисе. Это поле соответствует параметру `dateFrom` в запросе, если параметр `flag`=0 или не указан. Если часовой пояс не…
&Сериализуемое("lastChangeDate")
&Тип("Строка")
Перем lastChangeDate Экспорт;

// warehouseName - Строка - Склад отгрузки
&Сериализуемое("warehouseName")
&Тип("Строка")
Перем warehouseName Экспорт;

// warehouseType - Строка - Тип склада хранения товаров
&Сериализуемое("warehouseType")
&Тип("Строка")
Перем warehouseType Экспорт;

// countryName - Строка - Страна
&Сериализуемое("countryName")
&Тип("Строка")
Перем countryName Экспорт;

// oblastOkrugName - Строка - Округ
&Сериализуемое("oblastOkrugName")
&Тип("Строка")
Перем oblastOkrugName Экспорт;

// regionName - Строка - Регион
&Сериализуемое("regionName")
&Тип("Строка")
Перем regionName Экспорт;

// supplierArticle - Строка - Артикул продавца
&Сериализуемое("supplierArticle")
&Тип("Строка")
Перем supplierArticle Экспорт;

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// barcode - Строка - Баркод
&Сериализуемое("barcode")
&Тип("Строка")
Перем barcode Экспорт;

// category - Строка - Категория
&Сериализуемое("category")
&Тип("Строка")
Перем category Экспорт;

// subject - Строка - Предмет
&Сериализуемое("subject")
&Тип("Строка")
Перем subject Экспорт;

// brand - Строка - Бренд
&Сериализуемое("brand")
&Тип("Строка")
Перем brand Экспорт;

// techSize - Строка - Размер товара
&Сериализуемое("techSize")
&Тип("Строка")
Перем techSize Экспорт;

// incomeID - Число - Номер поставки
&Сериализуемое("incomeID")
&Тип("Число")
Перем incomeID Экспорт;

// isSupply - Булево - Договор поставки
&Сериализуемое("isSupply")
&Тип("Булево")
Перем isSupply Экспорт;

// isRealization - Булево - Договор реализации
&Сериализуемое("isRealization")
&Тип("Булево")
Перем isRealization Экспорт;

// totalPrice - Число - Цена без скидок
&Сериализуемое("totalPrice")
&Тип("Число")
Перем totalPrice Экспорт;

// discountPercent - Число - Скидка продавца, %
&Сериализуемое("discountPercent")
&Тип("Число")
Перем discountPercent Экспорт;

// spp - Число - Скидка WB, %
&Сериализуемое("spp")
&Тип("Число")
Перем spp Экспорт;

// finishedPrice - Число - Цена с учетом всех скидок, кроме суммы по WB Кошельку
&Сериализуемое("finishedPrice")
&Тип("Число")
Перем finishedPrice Экспорт;

// priceWithDisc - Число - Цена со скидкой продавца, в том числе со скидкой WB Клуба
&Сериализуемое("priceWithDisc")
&Тип("Число")
Перем priceWithDisc Экспорт;

// isCancel - Булево - Отмена заказа: - `true` — заказ отменен
&Сериализуемое("isCancel")
&Тип("Булево")
Перем isCancel Экспорт;

// cancelDate - Строка - Дата и время отмены заказа. Если заказ не был отменен, то \"0001-01-01T00:00:00\".Если часовой пояс не указан, то берётся Московское время UTC+3.
&Сериализуемое("cancelDate")
&Тип("Строка")
Перем cancelDate Экспорт;

// sticker - Строка - ID стикера
&Сериализуемое("sticker")
&Тип("Строка")
Перем sticker Экспорт;

// gNumber - Строка - ID корзины покупателя. Заказы одной транзакции будут иметь одинаковый `gNumber`
&Сериализуемое("gNumber")
&Тип("Строка")
Перем gNumber Экспорт;

// srid - Строка - Уникальный ID заказа. Примечание для использующих API Маркетплейс: `srid` равен `rid` в ответах методов сборочных заданий.
&Сериализуемое("srid")
&Тип("Строка")
Перем srid Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

