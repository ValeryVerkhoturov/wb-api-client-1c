#Использовать jason

// ReportsGetV1Deductions200ResponseDataReportsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// dtBonus - Дата - Дата и время удержания
&Сериализуемое("dtBonus")
&Тип("Дата")
Перем dtBonus Экспорт;

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// oldShkId - Число - Старый штрихкод
&Сериализуемое("oldShkId")
&Тип("Число")
Перем oldShkId Экспорт;

// oldColor - Строка - Старый цвет
&Сериализуемое("oldColor")
&Тип("Строка")
Перем oldColor Экспорт;

// oldSize - Строка - Старый размер
&Сериализуемое("oldSize")
&Тип("Строка")
Перем oldSize Экспорт;

// oldSku - Строка - Старый баркод
&Сериализуемое("oldSku")
&Тип("Строка")
Перем oldSku Экспорт;

// oldVendorCode - Строка - Старый артикул продавца
&Сериализуемое("oldVendorCode")
&Тип("Строка")
Перем oldVendorCode Экспорт;

// newShkId - Число - Новый штрихкод
&Сериализуемое("newShkId")
&Тип("Число")
Перем newShkId Экспорт;

// newColor - Строка - Новый цвет
&Сериализуемое("newColor")
&Тип("Строка")
Перем newColor Экспорт;

// newSize - Строка - Новый размер
&Сериализуемое("newSize")
&Тип("Строка")
Перем newSize Экспорт;

// newSku - Строка - Новый баркод
&Сериализуемое("newSku")
&Тип("Строка")
Перем newSku Экспорт;

// newVendorCode - Строка - Новый артикул продавца
&Сериализуемое("newVendorCode")
&Тип("Строка")
Перем newVendorCode Экспорт;

// bonusSumm - Число - Сумма удержания
&Сериализуемое("bonusSumm")
&Тип("Число")
Перем bonusSumm Экспорт;

// bonusType - Строка - Причина удержания
&Сериализуемое("bonusType")
&Тип("Строка")
Перем bonusType Экспорт;

// photoUrls - Массив - Фото замеров
&Сериализуемое("photoUrls")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем photoUrls Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

