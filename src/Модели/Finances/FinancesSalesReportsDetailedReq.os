#Использовать jason

// FinancesSalesReportsDetailedReq
//
// Параметры запроса
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// dateFrom - Строка - Начальная дата отчёта. Можно передать дату или дату со временем. Время можно указывать с точностью до секунд или миллисекунд. Дата передаётся в формате [RFC3339…
&Сериализуемое("dateFrom")
&Тип("Строка")
Перем dateFrom Экспорт;

// dateTo - Строка - Конечная дата отчёта. Дата в формате [RFC3339](https://datatracker.ietf.org/doc/html/rfc3339). Можно передать дату или дату со временем. Время можно указывать с…
&Сериализуемое("dateTo")
&Тип("Строка")
Перем dateTo Экспорт;

// limit - Число - Количество строк в ответе
&Сериализуемое("limit")
&Тип("Число")
Перем limit Экспорт;

// rrdId - Число - ID строки ответа. Необходим для получения отчёта частями. Начинайте загрузку отчёта с `\"rrdid\":0`. В последующих запросах передавайте значение `rrdId` из посл…
&Сериализуемое("rrdId")
&Тип("Число")
Перем rrdId Экспорт;

// period - Строка - Периодичность отчётов: - `weekly` — еженедельные - `daily` — ежедневные
&Сериализуемое("period")
&Тип("Строка")
Перем period Экспорт;

// fields - Массив - Список полей, которые вернутся в ответе. Если параметр не указан, возвращаются все поля
&Сериализуемое("fields")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем fields Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

