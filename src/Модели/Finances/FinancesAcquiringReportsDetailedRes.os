#Использовать jason

// FinancesAcquiringReportsDetailedRes
//
// Детализации к отчётам об издержках на приём платежей
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// rrdId - Число - ID строки
&Сериализуемое("rrdId")
&Тип("Число")
Перем rrdId Экспорт;

// reportId - Число - ID отчёта
&Сериализуемое("reportId")
&Тип("Число")
Перем reportId Экспорт;

// acqDate - Строка - Дата операции
&Сериализуемое("acqDate")
&Тип("Строка")
Перем acqDate Экспорт;

// acquiringBank - Строка - Наименование банка-эквайера
&Сериализуемое("acquiringBank")
&Тип("Строка")
Перем acquiringBank Экспорт;

// tin - Строка - ИНН
&Сериализуемое("tin")
&Тип("Строка")
Перем tin Экспорт;

// taxRegistrationReasonCode - Строка - КПП
&Сериализуемое("taxRegistrationReasonCode")
&Тип("Строка")
Перем taxRegistrationReasonCode Экспорт;

// saleDate - Строка - Дата продажи
&Сериализуемое("saleDate")
&Тип("Строка")
Перем saleDate Экспорт;

// srid - Строка - ID заказа. В ответах методов сборочных заданий [FBS](./orders-fbs#tag/fbsAssemblyOrders), [DBW](./orders-dbw#tag/dbwAssemblyOrders), [DBS](./dbs#tag/dbsAssembly…
&Сериализуемое("srid")
&Тип("Строка")
Перем srid Экспорт;

// documentType - Строка - Тип документа
&Сериализуемое("documentType")
&Тип("Строка")
Перем documentType Экспорт;

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// retailAmount - Строка - Wildberries реализовал Товар (Пр)
&Сериализуемое("retailAmount")
&Тип("Строка")
Перем retailAmount Экспорт;

// acquiringFee - Строка - Размер комиссии за эквайринг, в том числе НДС
&Сериализуемое("acquiringFee")
&Тип("Строка")
Перем acquiringFee Экспорт;

// acquiringFeeVat - Строка - Сумма НДС
&Сериализуемое("acquiringFeeVat")
&Тип("Строка")
Перем acquiringFeeVat Экспорт;

// invoiceNumber - Строка - Номер счёта-фактуры
&Сериализуемое("invoiceNumber")
&Тип("Строка")
Перем invoiceNumber Экспорт;

// invoiceDate - Строка - Дата счёта-фактуры
&Сериализуемое("invoiceDate")
&Тип("Строка")
Перем invoiceDate Экспорт;

// shkId - Число - Штрихкод
&Сериализуемое("shkId")
&Тип("Число")
Перем shkId Экспорт;

// currency - Строка - Валюта отчёта
&Сериализуемое("currency")
&Тип("Строка")
Перем currency Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

