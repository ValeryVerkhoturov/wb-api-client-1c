&Сериализуемое("shippingPointId")
&Тип("Число")
Перем shippingPointId Экспорт;

// shippingType - Строка - Способ доставки до пункта отгрузки: - `selfShipping` — доставка силами продавца - `transportCompany` — доставка через транспортную компанию
&Сериализуемое("shippingType")
&Тип("Строка")
Перем shippingType Экспорт;

// supplyId - Строка - ID поставки
&Сериализуемое("supplyId")
&Тип("Строка")
Перем supplyId Экспорт;

