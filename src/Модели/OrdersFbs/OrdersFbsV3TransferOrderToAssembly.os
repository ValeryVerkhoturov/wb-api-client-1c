//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// error - OrdersFbsV3TransferOrderToAssemblyError
&Сериализуемое("error")
&Тип("OrdersFbsV3TransferOrderToAssemblyError")
Перем error Экспорт;

// success - Булево - Успешна ли обработка запроса. Может быть только `true`
&Сериализуемое("success")
&Тип("Булево")
Перем success Экспорт;

// newStickerId - Число - Новый ID стикера
&Сериализуемое("newStickerId")
&Тип("Число")
Перем newStickerId Экспорт;

// oldStickerId - Число - Старый ID стикера
&Сериализуемое("oldStickerId")
&Тип("Число")
Перем oldStickerId Экспорт;

// orderId - Число - ID сборочного задания
&Сериализуемое("orderId")
&Тип("Число")
Перем orderId Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
