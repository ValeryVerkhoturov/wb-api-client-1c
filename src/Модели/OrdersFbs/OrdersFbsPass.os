#Использовать jason

// OrdersFbsPass
//
// Данные о пропуске продавца
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// firstName - Строка - Имя водителя
&Сериализуемое("firstName")
&Тип("Строка")
Перем firstName Экспорт;

// dateEnd - Строка - Дата окончания действия пропуска
&Сериализуемое("dateEnd")
&Тип("Строка")
Перем dateEnd Экспорт;

// lastName - Строка - Фамилия водителя
&Сериализуемое("lastName")
&Тип("Строка")
Перем lastName Экспорт;

// carModel - Строка - Марка машины
&Сериализуемое("carModel")
&Тип("Строка")
Перем carModel Экспорт;

// carNumber - Строка - Номер машины
&Сериализуемое("carNumber")
&Тип("Строка")
Перем carNumber Экспорт;

// officeName - Строка - Название склада
&Сериализуемое("officeName")
&Тип("Строка")
Перем officeName Экспорт;

// officeAddress - Строка - Адрес склада
&Сериализуемое("officeAddress")
&Тип("Строка")
Перем officeAddress Экспорт;

// officeId - Число - ID склада
&Сериализуемое("officeId")
&Тип("Число")
Перем officeId Экспорт;

// id - Число - ID пропуска
&Сериализуемое("id")
&Тип("Число")
Перем id Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

