#Использовать jason

// OrdersFbsOrder
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// address - OrdersFbsOrderAddress
&Сериализуемое("address")
&Тип("OrdersFbsOrderAddress")
Перем address Экспорт;

// scanPrice - Число - Цена приёмки в копейках. Отображается после фактической приёмки заказа
&Сериализуемое("scanPrice")
&Тип("Число")
Перем scanPrice Экспорт;

// deliveryType - Строка - Тип доставки: - `fbs` — доставка на склад Wildberries (FBS)
&Сериализуемое("deliveryType")
&Тип("Строка")
Перем deliveryType Экспорт;

// supplyId - Строка - ID поставки. Возвращается, если заказ закреплён за поставкой
&Сериализуемое("supplyId")
&Тип("Строка")
Перем supplyId Экспорт;

// orderUid - Строка - ID транзакции для группировки сборочных заданий. Сборочные задания в одной корзине покупателя будут иметь одинаковый `orderUid`
&Сериализуемое("orderUid")
&Тип("Строка")
Перем orderUid Экспорт;

// article - Строка - Артикул продавца
&Сериализуемое("article")
&Тип("Строка")
Перем article Экспорт;

// colorCode - Строка - Код цвета (только для колеруемых товаров)
&Сериализуемое("colorCode")
&Тип("Строка")
Перем colorCode Экспорт;

// rid - Строка - Уникальный ID заказа. Примечание: `rid` — это `srid` в ответах методов: - [Заявки покупателей на возврат](./customer-communication#tag/buyersReturns/operation/g…
&Сериализуемое("rid")
&Тип("Строка")
Перем rid Экспорт;

// createdAt - Дата - Дата создания сборочного задания (RFC3339). Часовой пояс — UTC
&Сериализуемое("createdAt")
&Тип("Дата")
Перем createdAt Экспорт;

// offices - Массив - Список офисов, куда следует привезти товар
&Сериализуемое("offices")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем offices Экспорт;

// skus - Массив - Список баркодов
&Сериализуемое("skus")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем skus Экспорт;

// id - Число - ID сборочного задания
&Сериализуемое("id")
&Тип("Число")
Перем id Экспорт;

// warehouseId - Число - ID склада продавца, на который поступило сборочное задание
&Сериализуемое("warehouseId")
&Тип("Число")
Перем warehouseId Экспорт;

// officeId - Число - ID склада WB, к которому привязан склад продавца
&Сериализуемое("officeId")
&Тип("Число")
Перем officeId Экспорт;

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// chrtId - Число - ID размера товара в системе WB
&Сериализуемое("chrtId")
&Тип("Число")
Перем chrtId Экспорт;

// price - Число - Цена в валюте продажи с учётом всех скидок, кроме скидки по WB Кошельку, умноженная на 100. Код валюты продажи — в поле `currencyCode`. Предоставляется в информ…
&Сериализуемое("price")
&Тип("Число")
Перем price Экспорт;

// convertedPrice - Число - Цена в валюте страны продавца с учетом всех скидок, кроме скидки по WB Кошельку, умноженная на 100. Предоставляется в информационных целях
&Сериализуемое("convertedPrice")
&Тип("Число")
Перем convertedPrice Экспорт;

// currencyCode - Число - Код валюты продажи
&Сериализуемое("currencyCode")
&Тип("Число")
Перем currencyCode Экспорт;

// convertedCurrencyCode - Число - Код валюты страны продавца
&Сериализуемое("convertedCurrencyCode")
&Тип("Число")
Перем convertedCurrencyCode Экспорт;

// cargoType - Число - Тип товара: - `1` — малогабаритный товар (МГТ) - `2` — сверхгабаритный товар (СГТ) - `3` — крупногабаритный товар (КГТ+)
&Сериализуемое("cargoType")
&Тип("Число")
Перем cargoType Экспорт;

// crossBorderType - Число - Тип сборочного задания: - `0` — внутренняя поставка - `1` — трансграничная поставка
&Сериализуемое("crossBorderType")
&Тип("Число")
Перем crossBorderType Экспорт;

// comment - Строка - Комментарий покупателя
&Сериализуемое("comment")
&Тип("Строка")
Перем comment Экспорт;

// isZeroOrder - Булево - Признак заказа товара с нулевым остатком: - `false` — заказ сделан на товар с ненулевым остатком - `true` — заказ сделан на товар с нулевым остатком. Такой зака…
&Сериализуемое("isZeroOrder")
&Тип("Булево")
Перем isZeroOrder Экспорт;

// options - OrdersFbsOrderOptions
&Сериализуемое("options")
&Тип("OrdersFbsOrderOptions")
Перем options Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

