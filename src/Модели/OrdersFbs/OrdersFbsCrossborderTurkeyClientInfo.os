#Использовать jason

// OrdersFbsCrossborderTurkeyClientInfo
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// firstName - Строка - Имя клиента
&Сериализуемое("firstName")
&Тип("Строка")
Перем firstName Экспорт;

// fullName - Строка - Фамилия, Имя, Отчество
&Сериализуемое("fullName")
&Тип("Строка")
Перем fullName Экспорт;

// lastName - Строка - Фамилия клиента
&Сериализуемое("lastName")
&Тип("Строка")
Перем lastName Экспорт;

// middleName - Строка - Отчество клиента
&Сериализуемое("middleName")
&Тип("Строка")
Перем middleName Экспорт;

// orderID - Число - Номер заказа
&Сериализуемое("orderID")
&Тип("Число")
Перем orderID Экспорт;

// phone - Строка - Телефон для связи с клиентом
&Сериализуемое("phone")
&Тип("Строка")
Перем phone Экспорт;

// phoneCode - Строка - Не используется
&Сериализуемое("phoneCode")
&Тип("Строка")
Перем phoneCode Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

