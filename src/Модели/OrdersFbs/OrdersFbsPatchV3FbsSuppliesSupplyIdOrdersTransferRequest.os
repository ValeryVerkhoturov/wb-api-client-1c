// orderIds - Массив - Список ID сборочных заданий, которые нужно перевести на сборку
&Сериализуемое("orderIds")
&Тип("Массив")
&ДляКаждого
&Тип("Число")
Перем orderIds Экспорт;

// newSupplyId - Строка - ID поставки, в которую будут перемещены сборочные задания. Поставка не должна быть в доставке
&Сериализуемое("newSupplyId")
&Тип("Строка")
Перем newSupplyId Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
