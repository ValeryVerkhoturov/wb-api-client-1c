#Использовать jason

// DbsDbsOnlyClientInfo
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// replacementPhone - Строка - Подменный номер для связи с покупателем. Пустое значение `\"\"` указывает, что номер еще не назначен
&Сериализуемое("replacementPhone")
&Тип("Строка")
Перем replacementPhone Экспорт;

// firstName - Строка - Имя покупателя
&Сериализуемое("firstName")
&Тип("Строка")
Перем firstName Экспорт;

// fullName - Строка - Полное имя, используется для оформления документов. Например, документы на автомобиль
&Сериализуемое("fullName")
&Тип("Строка")
Перем fullName Экспорт;

// orderID - Число - ID сборочного задания
&Сериализуемое("orderID")
&Тип("Число")
Перем orderID Экспорт;

// phone - Строка - Резервный подменный номер телефона для связи с покупателем. Используйте, если недоступен основной номер из `replacementPhone`. Чтобы позвонить покупателю, набер…
&Сериализуемое("phone")
&Тип("Строка")
Перем phone Экспорт;

// phoneCode - Число - Добавочный код. Пустое значение `\"\"` указывает, что код ещё не назначен
&Сериализуемое("phoneCode")
&Тип("Число")
Перем phoneCode Экспорт;

// additionalPhoneCodes - Массив - Дополнительные добавочные коды. Используйте, если не получилось дозвониться по добавочному коду из `phoneCode`. Пустое значение `\"\"` указывает, что код ещё не…
&Сериализуемое("additionalPhoneCodes")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем additionalPhoneCodes Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

