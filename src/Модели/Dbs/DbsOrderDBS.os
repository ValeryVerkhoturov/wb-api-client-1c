#Использовать jason

// DbsOrderDBS
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// address - DbsOrderDBSAddress
&Сериализуемое("address")
&Тип("DbsOrderDBSAddress")
Перем address Экспорт;

// deliveryType - Строка - Тип доставки: - `dbs` — доставка силами продавца - `dbsPickupPoint` — доставка силами продавца в ПВЗ - `edbs` — экспресс-доставка силами продавца
&Сериализуемое("deliveryType")
&Тип("Строка")
Перем deliveryType Экспорт;

// options - DbsOrderNewDBSOptions
&Сериализуемое("options")
&Тип("DbsOrderNewDBSOptions")
Перем options Экспорт;

// orderUid - Строка - ID транзакции для группировки сборочных заданий. Сборочные задания в одной корзине покупателя будут иметь одинаковый `orderUID`
&Сериализуемое("orderUid")
&Тип("Строка")
Перем orderUid Экспорт;

// groupId - Строка - ID группы сборочных заданий. Объединяет сборочные задания, поступившие на один склад (`warehouseId`) в рамках одной транзакции покупателя (`orderUid`)
&Сериализуемое("groupId")
&Тип("Строка")
Перем groupId Экспорт;

// article - Строка - Артикул продавца
&Сериализуемое("article")
&Тип("Строка")
Перем article Экспорт;

// colorCode - Строка - Код цвета (только для колеруемых товаров)
&Сериализуемое("colorCode")
&Тип("Строка")
Перем colorCode Экспорт;

// rid - Произвольный - Уникальный ID заказа. Примечание: `rid` — это `srid` в ответах методов: - [Заявки покупателей на возврат](./customer-communication#tag/buyersReturns/operation/g…
&Сериализуемое("rid")
&Тип("Произвольный")
Перем rid Экспорт;

// createdAt - Строка - Дата создания сборочного задания
&Сериализуемое("createdAt")
&Тип("Строка")
Перем createdAt Экспорт;

// skus - Массив - Массив баркодов товара
&Сериализуемое("skus")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем skus Экспорт;

// id - Число - ID сборочного задания
&Сериализуемое("id")
&Тип("Число")
Перем id Экспорт;

// warehouseId - Число - ID склада продавца, на который поступило сборочное задание
&Сериализуемое("warehouseId")
&Тип("Число")
Перем warehouseId Экспорт;

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// chrtId - Число - ID размера товара в системе WB
&Сериализуемое("chrtId")
&Тип("Число")
Перем chrtId Экспорт;

// scanPrice - Число - Цена приёмки заказов в ПВЗ, в копейках. Отображается только для заказов в ПВЗ
&Сериализуемое("scanPrice")
&Тип("Число")
Перем scanPrice Экспорт;

// price - Число - Цена в валюте продажи с учетом всех скидок, кроме скидки по WB Кошельку, умноженная на 100. Код валюты продажи указан в поле `currencyCode`. Предоставляется в и…
&Сериализуемое("price")
&Тип("Число")
Перем price Экспорт;

// convertedPrice - Число - Цена в валюте страны продавца с учетом всех скидок, кроме скидки по WB Кошельку, умноженная на 100. Предоставляется в информационных целях
&Сериализуемое("convertedPrice")
&Тип("Число")
Перем convertedPrice Экспорт;

// currencyCode - Число - Код валюты продажи
&Сериализуемое("currencyCode")
&Тип("Число")
Перем currencyCode Экспорт;

// convertedCurrencyCode - Число - Код валюты страны продавца
&Сериализуемое("convertedCurrencyCode")
&Тип("Число")
Перем convertedCurrencyCode Экспорт;

// convertedFinalPrice - Число - Сумма к оплате покупателем в валюте страны продавца с учетом всех скидок, умноженная на 100. Предоставляется в информационных целях. Используйте значение поля `…
&Сериализуемое("convertedFinalPrice")
&Тип("Число")
Перем convertedFinalPrice Экспорт;

// finalPrice - Число - Сумма к оплате покупателем в валюте продажи с учётом всех скидок, умноженная на 100. Код валюты продажи указан в поле `currencyCode`. Предоставляется в информац…
&Сериализуемое("finalPrice")
&Тип("Число")
Перем finalPrice Экспорт;

// cargoType - Число - Тип товара: - `1` — малогабаритный товар (МГТ) - `2` — сверхгабаритный товар (СГТ) - `3` — крупногабаритный товар (КГТ+)
&Сериализуемое("cargoType")
&Тип("Число")
Перем cargoType Экспорт;

// comment - Строка - Комментарий покупателя
&Сериализуемое("comment")
&Тип("Строка")
Перем comment Экспорт;

// isZeroOrder - Булево - Признак заказа товара с нулевым остатком: - `false` — заказ сделан на товар с ненулевым остатком - `true` — заказ сделан на товар с нулевым остатком. Такой зака…
&Сериализуемое("isZeroOrder")
&Тип("Булево")
Перем isZeroOrder Экспорт;

// wbStickerId - Число - ID стикера. Отображается только для заказов в ПВЗ
&Сериализуемое("wbStickerId")
&Тип("Число")
Перем wbStickerId Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

