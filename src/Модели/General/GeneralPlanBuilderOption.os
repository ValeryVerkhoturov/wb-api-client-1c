#Использовать jason

// GeneralPlanBuilderOption
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// id - Строка - ID опции
&Сериализуемое("id")
&Тип("Строка")
Перем id Экспорт;

// slug - Строка - Код опции
&Сериализуемое("slug")
&Тип("Строка")
Перем slug Экспорт;

// name - Строка - Название опции на языке из параметра `locale`
&Сериализуемое("name")
&Тип("Строка")
Перем name Экспорт;

// status - Строка - Статус опции: - `active` — активна - `pendingActivation` — подключена, начнёт работать с 00:00 следующего дня - `pendingDeactivation` — отключена, перестанет ра…
&Сериализуемое("status")
&Тип("Строка")
Перем status Экспорт;

// activatedAt - Строка - Дата активации опции
&Сериализуемое("activatedAt")
&Тип("Строка")
Перем activatedAt Экспорт;

// expiresAt - Строка - Дата окончания минимального срока действия опции. До этого дня опцию нельзя отключить
&Сериализуемое("expiresAt")
&Тип("Строка")
Перем expiresAt Экспорт;

// commissionRate - Число - Стоимость подключения опции, % от оборота. Возвращается, если в ответе нет объекта `promotion`
&Сериализуемое("commissionRate")
&Тип("Число")
Перем commissionRate Экспорт;

// periodDuration - Число - Минимальный срок действия опции в днях
&Сериализуемое("periodDuration")
&Тип("Число")
Перем periodDuration Экспорт;

// promotion - GeneralPlanBuilderOptionPromotion
&Сериализуемое("promotion")
&Тип("GeneralPlanBuilderOptionPromotion")
Перем promotion Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

