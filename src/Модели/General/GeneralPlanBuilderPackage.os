#Использовать jason

// GeneralPlanBuilderPackage
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// id - Строка - ID пакета
&Сериализуемое("id")
&Тип("Строка")
Перем id Экспорт;

// slug - Строка - Код пакета
&Сериализуемое("slug")
&Тип("Строка")
Перем slug Экспорт;

// name - Строка - Название пакета на языке из параметра `locale`
&Сериализуемое("name")
&Тип("Строка")
Перем name Экспорт;

// status - Строка - Статус пакета: - `active` — активен - `pendingActivation` — подключён, начнёт работать с 00:00 следующего дня - `pendingDeactivation` — отключён, перестанет раб…
&Сериализуемое("status")
&Тип("Строка")
Перем status Экспорт;

// activatedAt - Строка - Дата активации пакета
&Сериализуемое("activatedAt")
&Тип("Строка")
Перем activatedAt Экспорт;

// expiresAt - Строка - Дата окончания минимального срока действия пакета. До этого дня пакет опций нельзя отключить
&Сериализуемое("expiresAt")
&Тип("Строка")
Перем expiresAt Экспорт;

// commissionRate - Число - Комиссия за пакет, % от оборота
&Сериализуемое("commissionRate")
&Тип("Число")
Перем commissionRate Экспорт;

// periodDuration - Число - Минимальный срок действия пакета в днях
&Сериализуемое("periodDuration")
&Тип("Число")
Перем periodDuration Экспорт;

// options - Массив - Опции, которые входят в пакет
&Сериализуемое("options")
&Тип("Массив")
&ДляКаждого
&Тип("GeneralPlanBuilderOptionShort")
Перем options Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

