#Использовать jason

// PromotionStatsBlok2
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// item_id - Число - ID баннера
&Сериализуемое("item_id")
&Тип("Число")
Перем item_id Экспорт;

// item_name - Строка - Бренд
&Сериализуемое("item_name")
&Тип("Строка")
Перем item_name Экспорт;

// category_name - Строка - Название категории
&Сериализуемое("category_name")
&Тип("Строка")
Перем category_name Экспорт;

// advert_type - Число - Тип медиакампании: - `1` — размещение по дням - `2` — размещение по просмотрам
&Сериализуемое("advert_type")
&Тип("Число")
Перем advert_type Экспорт;

// place - Число - Место на странице
&Сериализуемое("place")
&Тип("Число")
Перем place Экспорт;

// views - Число - Количество просмотров
&Сериализуемое("views")
&Тип("Число")
Перем views Экспорт;

// clicks - Число - Количество кликов
&Сериализуемое("clicks")
&Тип("Число")
Перем clicks Экспорт;

// cr - Число - CR(conversion rate) — это отношение количества заказов к общему количеству посещений медиакампании
&Сериализуемое("cr")
&Тип("Число")
Перем cr Экспорт;

// ctr - Число - CTR (click-through rate) — показатель кликабельности, отношение числа кликов к количеству показов в рамках медиакампании
&Сериализуемое("ctr")
&Тип("Число")
Перем ctr Экспорт;

// date_from - Дата - Время начала размещения
&Сериализуемое("date_from")
&Тип("Дата")
Перем date_from Экспорт;

// date_to - Дата - Время завершения размещения
&Сериализуемое("date_to")
&Тип("Дата")
Перем date_to Экспорт;

// subject_name - Строка - Родительская категория предмета
&Сериализуемое("subject_name")
&Тип("Строка")
Перем subject_name Экспорт;

// atbs - Число - Количество добавлений товаров в корзину
&Сериализуемое("atbs")
&Тип("Число")
Перем atbs Экспорт;

// orders - Число - Количество заказов
&Сериализуемое("orders")
&Тип("Число")
Перем orders Экспорт;

// price - Число - Стоимость размещения
&Сериализуемое("price")
&Тип("Число")
Перем price Экспорт;

// cpc - Число - (cost per click) — цена клика по продвигаемому товару
&Сериализуемое("cpc")
&Тип("Число")
Перем cpc Экспорт;

// status - Число - Статус медиакампании
&Сериализуемое("status")
&Тип("Число")
Перем status Экспорт;

// daily_stats - Массив
&Сериализуемое("daily_stats")
&Тип("Массив")
&ДляКаждого
&Тип("PromotionStatsBlok2DailyStatsInner")
Перем daily_stats Экспорт;

// expenses - Число - Стоимость размещения баннера
&Сериализуемое("expenses")
&Тип("Число")
Перем expenses Экспорт;

// cr1 - Число - Отношение количества добавлений в корзину к количеству кликов
&Сериализуемое("cr1")
&Тип("Число")
Перем cr1 Экспорт;

// cr2 - Число - Отношение количества заказов к количеству добавлений в корзину
&Сериализуемое("cr2")
&Тип("Число")
Перем cr2 Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

