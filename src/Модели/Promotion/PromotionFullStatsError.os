#Использовать jason

// PromotionFullStatsError
//
// Ошибка
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// errors - Массив
&Сериализуемое("errors")
&Тип("Массив")
&ДляКаждого
&Тип("PromotionFullStatsErrorErrorsInner")
Перем errors Экспорт;

// detail - Строка - Детали ошибки
&Сериализуемое("detail")
&Тип("Строка")
Перем detail Экспорт;

// origin - Строка - ID внутреннего сервиса WB
&Сериализуемое("origin")
&Тип("Строка")
Перем origin Экспорт;

// request_id - Строка - ID запроса
&Сериализуемое("request_id")
&Тип("Строка")
Перем request_id Экспорт;

// status - Число - HTTP статус-код
&Сериализуемое("status")
&Тип("Число")
Перем status Экспорт;

// title - Строка - Заголовок ошибки
&Сериализуемое("title")
&Тип("Строка")
Перем title Экспорт;

// type - Строка - Тип ошибки
&Сериализуемое("type")
&Тип("Строка")
Перем type Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

