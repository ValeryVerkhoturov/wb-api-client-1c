// normQueries - Массив - Рекомендуемые ставки для поисковых кластеров
&Сериализуемое("normQueries")
&Тип("Массив")
&ДляКаждого
&Тип("PromotionV0BidRecommendationNormQuery")
Перем normQueries Экспорт;

// paymentType - Строка - Тип оплаты: - `cpc` — за клики
&Сериализуемое("paymentType")
&Тип("Строка")
Перем paymentType Экспорт;

// levels - Массив - Рекомендуемые ставки для карточек товаров
&Сериализуемое("levels")
&Тип("Массив")
