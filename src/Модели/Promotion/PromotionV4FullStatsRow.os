#Использовать jason

// PromotionV4FullStatsRow
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// advertId - Число - ID рекламной кампании
&Сериализуемое("advertId")
&Тип("Число")
Перем advertId Экспорт;

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// date - Строка - Дата, за которую предоставлены данные
&Сериализуемое("date")
&Тип("Строка")
Перем date Экспорт;

// placement - PromotionV4FullStatsPlacement
&Сериализуемое("placement")
&Тип("PromotionV4FullStatsPlacement")
Перем placement Экспорт;

// conversionType - PromotionV4FullStatsConversionType
&Сериализуемое("conversionType")
&Тип("PromotionV4FullStatsConversionType")
Перем conversionType Экспорт;

// currency - Строка - Валюта [профиля продавца](https://cmp.wildberries.ru/campaigns/finances)
&Сериализуемое("currency")
&Тип("Строка")
Перем currency Экспорт;

// views - Число - Показы. Для `\"conversionType\":\"multicard\"` и `\"conversionType\":\"associated\"` возвращается `0`, если показ был на другом товаре
&Сериализуемое("views")
&Тип("Число")
Перем views Экспорт;

// clicks - Число - Количество кликов. Только для `\"conversionType\":\"direct\"`
&Сериализуемое("clicks")
&Тип("Число")
Перем clicks Экспорт;

// ctr - Число - Кликабельность — отношение числа кликов к количеству показов, %
&Сериализуемое("ctr")
&Тип("Число")
Перем ctr Экспорт;

// cpc - Число - Стоимость клика в базовых единицах валюты [профиля продавца](https://cmp.wildberries.ru/campaigns/finances)
&Сериализуемое("cpc")
&Тип("Число")
Перем cpc Экспорт;

// sum - Число - Затраты в базовых единицах валюты [профиля продавца](https://cmp.wildberries.ru/campaigns/finances). Только для `\"conversionType\":\"direct\"`
&Сериализуемое("sum")
&Тип("Число")
Перем sum Экспорт;

// atbs - Число - Сколько раз товар добавили в корзину
&Сериализуемое("atbs")
&Тип("Число")
Перем atbs Экспорт;

// orders - Число - Количество заказов
&Сериализуемое("orders")
&Тип("Число")
Перем orders Экспорт;

// cr - Число - Отношение количества заказов к общему количеству кликов
&Сериализуемое("cr")
&Тип("Число")
Перем cr Экспорт;

// shks - Число - Количество заказанных товаров, шт.
&Сериализуемое("shks")
&Тип("Число")
Перем shks Экспорт;

// sumPrice - Число - Сумма заказов в базовых единицах валюты [профиля продавца](https://cmp.wildberries.ru/campaigns/finances)
&Сериализуемое("sumPrice")
&Тип("Число")
Перем sumPrice Экспорт;

// canceled - Число - Количество отмен
&Сериализуемое("canceled")
&Тип("Число")
Перем canceled Экспорт;

// avgPos - Число - Средняя позиция товара на страницах поисковой выдачи. Возвращается только при комбинации значений `\"placement\":search` и `\"conversionType\":\"direct\"`
&Сериализуемое("avgPos")
&Тип("Число")
Перем avgPos Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

