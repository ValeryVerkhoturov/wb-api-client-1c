#Использовать jason

// PromotionPromoItemsList
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// id - Число - Артикул WB
&Сериализуемое("id")
&Тип("Число")
Перем id Экспорт;

// inAction - Булево - Участвует в акции: - `true` — да - `false` — нет
&Сериализуемое("inAction")
&Тип("Булево")
Перем inAction Экспорт;

// price - Число - Текущая розничная цена
&Сериализуемое("price")
&Тип("Число")
Перем price Экспорт;

// currencyCode - Строка - Валюта в формате ISO 4217
&Сериализуемое("currencyCode")
&Тип("Строка")
Перем currencyCode Экспорт;

// planPrice - Число - Плановая цена (цена во время акции)
&Сериализуемое("planPrice")
&Тип("Число")
Перем planPrice Экспорт;

// discount - Число - Текущая скидка
&Сериализуемое("discount")
&Тип("Число")
Перем discount Экспорт;

// planDiscount - Число - Рекомендуемая скидка для участия в акции
&Сериализуемое("planDiscount")
&Тип("Число")
Перем planDiscount Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

