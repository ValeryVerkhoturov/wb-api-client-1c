#Использовать jason

// PromotionV3GetAdverts
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// advertId - Число - ID кампании
&Сериализуемое("advertId")
&Тип("Число")
Перем advertId Экспорт;

// status - Число - Статус кампании: - `4` — готова к запуску - `7` — завершена - `9` — активна - `11` — на паузе
&Сериализуемое("status")
&Тип("Число")
Перем status Экспорт;

// timestamps - PromotionTimestamps
&Сериализуемое("timestamps")
&Тип("PromotionTimestamps")
Перем timestamps Экспорт;

// settings - PromotionV3AdvertSettings
&Сериализуемое("settings")
&Тип("PromotionV3AdvertSettings")
Перем settings Экспорт;

// nms - Массив - Настройки товаров
&Сериализуемое("nms")
&Тип("Массив")
&ДляКаждого
&Тип("PromotionV3AdvertNMsSettings")
Перем nms Экспорт;

// currency - Строка - Код валюты
&Сериализуемое("currency")
&Тип("Строка")
Перем currency Экспорт;

// restrictions - PromotionV3GetAdvertsRestrictions
&Сериализуемое("restrictions")
&Тип("PromotionV3GetAdvertsRestrictions")
Перем restrictions Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

