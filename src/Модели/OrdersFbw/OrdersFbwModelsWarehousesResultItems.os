#Использовать jason

// OrdersFbwModelsWarehousesResultItems
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// ID - Число - ID склада
&Сериализуемое("ID")
&Тип("Число")
Перем ID Экспорт;

// name - Строка - Название склада
&Сериализуемое("name")
&Тип("Строка")
Перем name Экспорт;

// address - Строка - Адрес склада
&Сериализуемое("address")
&Тип("Строка")
Перем address Экспорт;

// workTime - Строка - Режим работы склада
&Сериализуемое("workTime")
&Тип("Строка")
Перем workTime Экспорт;

// isActive - Булево - Доступен ли в качестве склада назначения: - `true` — да - `false` — нет
&Сериализуемое("isActive")
&Тип("Булево")
Перем isActive Экспорт;

// isTransitActive - Булево - Доступен ли в качестве транзитного склада: - `true` — да - `false` — нет
&Сериализуемое("isTransitActive")
&Тип("Булево")
Перем isTransitActive Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

