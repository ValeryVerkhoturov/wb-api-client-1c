#Использовать jason

// OrdersFbwModelsGoodInSupply
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// barcode - Строка - Баркод товара
&Сериализуемое("barcode")
&Тип("Строка")
Перем barcode Экспорт;

// vendorCode - Строка - Артикул продавца
&Сериализуемое("vendorCode")
&Тип("Строка")
Перем vendorCode Экспорт;

// nmID - Число - Артикул WB
&Сериализуемое("nmID")
&Тип("Число")
Перем nmID Экспорт;

// needKiz - Булево - Нужен ли [код маркировки Честного знака](https://честныйзнак.рф/) для этого товара: - `false` — не нужен - `true` — нужен
&Сериализуемое("needKiz")
&Тип("Булево")
Перем needKiz Экспорт;

// tnved - Строка - Код ТНВЭД. Если `\"needKiz\":true`, а `\"tnved\":null`, нужно заполнить характеристику товара \\*\\*ТН ВЭД\\*\\* в [личном кабинете](https://seller.wildberries.…
&Сериализуемое("tnved")
&Тип("Строка")
Перем tnved Экспорт;

// techSize - Строка - Размер товара, указанный продавцом
&Сериализуемое("techSize")
&Тип("Строка")
Перем techSize Экспорт;

// color - Строка - Цвет товара
&Сериализуемое("color")
&Тип("Строка")
Перем color Экспорт;

// supplierBoxAmount - Число - Указано в упаковке, шт
&Сериализуемое("supplierBoxAmount")
&Тип("Число")
Перем supplierBoxAmount Экспорт;

// quantity - Число - Указано в поставке/заказе, шт
&Сериализуемое("quantity")
&Тип("Число")
Перем quantity Экспорт;

// readyForSaleQuantity - Число - Поступило в продажу, шт
&Сериализуемое("readyForSaleQuantity")
&Тип("Число")
Перем readyForSaleQuantity Экспорт;

// acceptedQuantity - Число - Принято, шт
&Сериализуемое("acceptedQuantity")
&Тип("Число")
Перем acceptedQuantity Экспорт;

// unloadingQuantity - Число - Количество товара на раскладке, шт
&Сериализуемое("unloadingQuantity")
&Тип("Число")
Перем unloadingQuantity Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

