#Использовать jason

// OrdersFbwModelsDraftItem
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// draftId - Строка - ID черновика
&Сериализуемое("draftId")
&Тип("Строка")
Перем draftId Экспорт;

// phone - Строка - Телефон пользователя, создавшего черновик
&Сериализуемое("phone")
&Тип("Строка")
Перем phone Экспорт;

// createdAt - Строка - Дата и время создания черновика
&Сериализуемое("createdAt")
&Тип("Строка")
Перем createdAt Экспорт;

// updatedAt - Строка - Дата и время последнего обновления черновика
&Сериализуемое("updatedAt")
&Тип("Строка")
Перем updatedAt Экспорт;

// skuQuantity - Число - Количество баркодов
&Сериализуемое("skuQuantity")
&Тип("Число")
Перем skuQuantity Экспорт;

// itemQuantity - Число - Количество единиц товара
&Сериализуемое("itemQuantity")
&Тип("Число")
Перем itemQuantity Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

