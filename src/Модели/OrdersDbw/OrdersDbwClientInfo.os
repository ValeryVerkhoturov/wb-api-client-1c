#Использовать jason

// OrdersDbwClientInfo
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// replacementPhone - Строка - Подменный номер для связи с покупателем. Пустое значение `\"\"` указывает, что номер ещё не назначен
&Сериализуемое("replacementPhone")
&Тип("Строка")
Перем replacementPhone Экспорт;

// phone - Строка - Номер телефона для связи с покупателем: - если в поле `phoneCode` не указан добавочный код, вы можете позвонить покупателю по указанному номеру. Дополнительные…
&Сериализуемое("phone")
&Тип("Строка")
Перем phone Экспорт;

// firstName - Строка - Имя покупателя
&Сериализуемое("firstName")
&Тип("Строка")
Перем firstName Экспорт;

// fullName - Строка - Полное имя покупателя, используется для оформления документов
&Сериализуемое("fullName")
&Тип("Строка")
Перем fullName Экспорт;

// additionalPhones - Массив - Дополнительные прямые номера телефонов для связи с покупателем. Используйте, чтобы позвонить покупателю, если недоступен основной номер из `phone`. Пустое значе…
&Сериализуемое("additionalPhones")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем additionalPhones Экспорт;

// replacementAdditionalPhones - Массив - Дополнительные подменные номера телефонов для связи с покупателем. Пустое значение означает, что номер не указан
&Сериализуемое("replacementAdditionalPhones")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем replacementAdditionalPhones Экспорт;

// additionalPhoneCodes - Массив - Дополнительные добавочные коды. Используйте, если не получилось дозвониться по добавочному коду из `phoneCode`. Пустое значение указывает, коды ещё не назначены
&Сериализуемое("additionalPhoneCodes")
&Тип("Массив")
&ДляКаждого
&Тип("Число")
Перем additionalPhoneCodes Экспорт;

// orderId - Число - ID сборочного задания
&Сериализуемое("orderId")
&Тип("Число")
Перем orderId Экспорт;

// phoneCode - Число - Добавочный код. Используйте, чтобы связаться с покупателем по номеру из `phone`. Если код не указан, вы можете связаться с покупателем без кода
&Сериализуемое("phoneCode")
&Тип("Число")
Перем phoneCode Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

