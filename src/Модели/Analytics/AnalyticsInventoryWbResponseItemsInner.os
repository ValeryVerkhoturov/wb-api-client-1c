#Использовать jason

// AnalyticsInventoryWbResponseItemsInner
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// chrtId - Число - ID размера
&Сериализуемое("chrtId")
&Тип("Число")
Перем chrtId Экспорт;

// warehouseId - Число - [ID склада](https://dev.wildberries.ru/release-notes?id=605)
&Сериализуемое("warehouseId")
&Тип("Число")
Перем warehouseId Экспорт;

// warehouseName - Строка - [Название склада](https://dev.wildberries.ru/release-notes?id=605)
&Сериализуемое("warehouseName")
&Тип("Строка")
Перем warehouseName Экспорт;

// regionName - Строка - [Страна отгрузки](https://dev.wildberries.ru/release-notes?id=605)
&Сериализуемое("regionName")
&Тип("Строка")
Перем regionName Экспорт;

// quantity - Число - Количество товара на складе, доступное клиентам для добавления в корзину
&Сериализуемое("quantity")
&Тип("Число")
Перем quantity Экспорт;

// inWayToClient - Число - В пути к клиенту
&Сериализуемое("inWayToClient")
&Тип("Число")
Перем inWayToClient Экспорт;

// inWayFromClient - Число - В пути от клиента
&Сериализуемое("inWayFromClient")
&Тип("Число")
Перем inWayFromClient Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

