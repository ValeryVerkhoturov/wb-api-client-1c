#Использовать jason

// AnalyticsTableItemRequest
//
// Параметры запроса об остатках по товарам
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// nmIDs - Массив - Список артикулов WB для фильтрации
&Сериализуемое("nmIDs")
&Тип("Массив")
&ДляКаждого
&Тип("Число")
Перем nmIDs Экспорт;

// subjectID - Число - ID предмета
&Сериализуемое("subjectID")
&Тип("Число")
Перем subjectID Экспорт;

// brandName - Строка - Бренд
&Сериализуемое("brandName")
&Тип("Строка")
Перем brandName Экспорт;

// tagID - Число - ID ярлыка
&Сериализуемое("tagID")
&Тип("Число")
Перем tagID Экспорт;

// currentPeriod - AnalyticsPeriodInv
&Сериализуемое("currentPeriod")
&Тип("AnalyticsPeriodInv")
Перем currentPeriod Экспорт;

// stockType - AnalyticsStockType
&Сериализуемое("stockType")
&Тип("AnalyticsStockType")
Перем stockType Экспорт;

// skipDeletedNm - Булево - Скрыть удалённые товары
&Сериализуемое("skipDeletedNm")
&Тип("Булево")
Перем skipDeletedNm Экспорт;

// orderBy - AnalyticsTableOrderBy
&Сериализуемое("orderBy")
&Тип("AnalyticsTableOrderBy")
Перем orderBy Экспорт;

// availabilityFilters - Массив - Доступность товара: - `deficient` — Дефицит - `actual` — Актуальный - `balanced` — Баланс - `nonActual` — Неактуальный - `nonLiquid` — Неликвид - `invalidData`…
&Сериализуемое("availabilityFilters")
&Тип("Массив")
&ДляКаждого
&Тип("Строка")
Перем availabilityFilters Экспорт;

// limit - Число - Количество товаров в ответе
&Сериализуемое("limit")
&Тип("Число")
Перем limit Экспорт;

// offset - Число - После какого элемента выдавать данные
&Сериализуемое("offset")
&Тип("Число")
Перем offset Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

