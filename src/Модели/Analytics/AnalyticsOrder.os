#Использовать jason

// AnalyticsOrder
//
// Заказ
//
// Класс сформирован автоматически (onescript) из спецификации OpenAPI.
// Правки будут потеряны при следующей генерации.
//
// Форма свойства описана аннотациями: jason берёт из `&Сериализуемое` имя поля
// в JSON, а из `&Тип` и `&ДляКаждого` — класс, в который разбирать значение,
// поэтому вложенные модели и массивы моделей восстанавливаются сами собой.

// nmId - Число - Артикул WB
&Сериализуемое("nmId")
&Тип("Число")
Перем nmId Экспорт;

// chrtId - Число - ID размера
&Сериализуемое("chrtId")
&Тип("Число")
Перем chrtId Экспорт;

// srid - Строка - ID заказа
&Сериализуемое("srid")
&Тип("Строка")
Перем srid Экспорт;

// createdAt - Строка - Дата и время оформления заказа
&Сериализуемое("createdAt")
&Тип("Строка")
Перем createdAt Экспорт;

// updatedAt - Строка - Дата и время текущего статуса. При `\"status\":\"created\"` возвращается значение поля `createdAt`
&Сериализуемое("updatedAt")
&Тип("Строка")
Перем updatedAt Экспорт;

// status - Строка - [Статус заказа](https://seller.wildberries.ru/instructions/material/order-feed-report#a92fa9b0-86ab-4990-b905-33f6c38b385c): - `created` — оформлен - `buyout` —…
&Сериализуемое("status")
&Тип("Строка")
Перем status Экспорт;

// cancelType - Строка - [Тип отмены](https://seller.wildberries.ru/instructions/material/order-feed-report#a92fa9b0-86ab-4990-b905-33f6c38b385c) (при `\"status\":\"cancel\"`): - `app`…
&Сериализуемое("cancelType")
&Тип("Строка")
Перем cancelType Экспорт;

// warehouseName - Строка - Название склада. Для складов WB в России может быть только `Склад WB РФ` или `Склад WB СГТ РФ`
&Сериализуемое("warehouseName")
&Тип("Строка")
Перем warehouseName Экспорт;

// warehouseRegion - Строка - Регион отгрузки. Если склад принадлежит WB или продавцу не в России, возвращается страна
&Сериализуемое("warehouseRegion")
&Тип("Строка")
Перем warehouseRegion Экспорт;

// isMp - Булево - Тип склада: - `true` — склад продавца - `false` — склад WB
&Сериализуемое("isMp")
&Тип("Булево")
Перем isMp Экспорт;

// destinationCity - Строка - Населённый пункт доставки
&Сериализуемое("destinationCity")
&Тип("Строка")
Перем destinationCity Экспорт;

// destinationDistrict - Строка - Федеральный округ доставки. Если доставка не по России, возвращается страна
&Сериализуемое("destinationDistrict")
&Тип("Строка")
Перем destinationDistrict Экспорт;

// sellerPrice - Число - Цена продавца со скидкой продавца (без учёта скидки WB Клуба и оптовой скидки для B2B-продаж)
&Сериализуемое("sellerPrice")
&Тип("Число")
Перем sellerPrice Экспорт;

// isB2b - Булево - Тип продажи: - `true` — B2B - `false` — B2C
&Сериализуемое("isB2b")
&Тип("Булево")
Перем isB2b Экспорт;

// Возвращает JSON-представление модели.
//
// Незаполненные свойства пропускаются, поэтому в теле запроса не появится
// null там, где сервис ожидает отсутствие поля.
//
// Возвращаемое значение:
//   Строка
//
Функция ВJson() Экспорт
	Возврат Новый СериализаторJson().Сериализовать(ЭтотОбъект);
КонецФункции

